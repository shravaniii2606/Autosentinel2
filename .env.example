# Google Earth Engine service-account auth for headless deploys.
# Create a service account JSON key in your GCP project,
# then paste the complete JSON key as one single-line env var value.
# Keep the private_key newline escapes as \n and never commit real key material.
GEE_SERVICE_ACCOUNT_EMAIL=REPLACE_ME
GEE_SERVICE_ACCOUNT_KEY=REPLACE_ME

# ─── PostgreSQL (primary persistence) ───────────────────────────────────────────
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/autosentinel

# ─── Supabase (optional legacy — only needed if mirroring to Supabase) ──────────
SUPABASE_URL=REPLACE_ME
SUPABASE_SERVICE_KEY=REPLACE_ME

# AI assistant pipeline
MEM0_API_KEY=REPLACE_ME
ALCHEMYST_AI_API_KEY=REPLACE_ME
OPENROUTER_API_KEY=REPLACE_ME
